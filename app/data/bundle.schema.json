{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stocka.xeye.es/contract/bundle/bundle.schema.json",
  "title": "stocka-bundle manifest",
  "description": "manifest.json de un paquete autocontenido .belen.zip: un show stocka-show v2 más sus ficheros de audio y vídeo, con el sha256 de cada fichero para que la Raspberry Pi pueda verificarlo sin red.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "show", "files", "createdAt", "createdBy"],
  "properties": {
    "format": { "const": "stocka-bundle" },
    "version": { "const": 1 },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "name", "board"],
      "properties": {
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "name": { "type": "string", "minLength": 1 },
        "timelineId": { "type": ["integer", "null"] },
        "board": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "pattern": "^(show\\.json|assets/(audio|video)/[^/\\\\]+)$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["show", "audio", "video"] }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 1 },
    "activate": { "type": "boolean" }
  }
}
